# ─────────────────────────────────────────────────────────────
# ReviewHub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Supabase project reference (found in Project Settings → General)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase anon/publishable key (safe to expose in client-side code)
# Found in Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# ─────────────────────────────────────────────────────────────
# The following are configured server-side in Supabase Edge
# Function secrets and are NOT required in this file:
#
#   RESEND_API_KEY          — transactional email (Resend)
#   HYP_TERMINAL_NUMBER     — hyp (YaadPay) terminal number (Masof)
#   HYP_API_KEY             — hyp (YaadPay) terminal password (PassP)
#   CRON_SECRET             — shared secret for daily billing-reminders cron
#   TURNSTILE_SECRET_KEY    — Cloudflare Turnstile server-side validation
# ─────────────────────────────────────────────────────────────
