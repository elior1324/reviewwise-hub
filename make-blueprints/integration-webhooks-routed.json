                "name": "Pro Monthly",
                "conditions": [[{ "a": "{{1.price_id}}", "b": "plan_pro_monthly", "o": "text:equal" }]]
              },
              "mapper": {
                "title": "{{1.title}}",
                "sendingMode": 3,
                "pageFieldSettings": {
                  "fullName": "{{1.full_name}}",
                  "phone": "{{1.phone}}",
                  "email": "{{1.user_email}}"
                },
                "chargeType": 1,
                "successUrl": "{{1.success_url}}",
                "products": {
                  "data": [{
                    "catalogNumber": "plan_pro_monthly",
                    "name": "ReviewHub Pro — חודשי",
                    "price": 189,
                    "quantity": 1,
                    "vatType": 1
                  }]
                },
                "cField1": "{{1.plan}}",
                "cField2": "{{1.user_id}}",
                "cField3": "{{1.price_id}}",
                "cField4": "{{1.billing_cycle}}",
                "cField5": "{{1.user_email}}"
              },
              "metadata": { "designer": { "x": 600, "y": -450 } }
            },
